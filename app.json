{
  "expo": {
    "name": "CPE Keeper",
    "slug": "cpe-keeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nazimiqbal.cpekeeper"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031D4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CPE Keeper uses your photos so you can upload CPE certificates.",
          "cameraPermission": "CPE Keeper uses the camera so you can photograph CPE certificates."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#031D4A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#031D4A"
          }
        }
      ]
    ]
  }
}
