{
  "state": "CA",
  "board": "California Board of Accountancy",
  "sourceUrls": [
    "https://www.dca.ca.gov/cba/licensees/cequickref.shtml",
    "https://www.dca.ca.gov/cba/licensees/overview-of-renewal-process.pdf"
  ],
  "lastVerified": "2026-09-25",
  "cycle": {
    "type": "ending_at_license_expiration",
    "lengthMonths": 24,
    "subPeriods": 2,
    "note": "80 hours in the two-year period immediately preceding license expiration; each year of the period measured back from the expiration date."
  },
  "carryover": false,
  "requirements": [
    {
      "id": "total",
      "label": "Total CE",
      "hours": 80,
      "scope": "cycle"
    },
    {
      "id": "annual_total",
      "label": "Minimum each year",
      "hours": 20,
      "scope": "each_sub_period"
    },
    {
      "id": "technical_total",
      "label": "Technical subject matter",
      "hours": 40,
      "scope": "cycle",
      "categories": [
        "technical"
      ]
    },
    {
      "id": "technical_annual",
      "label": "Technical each year",
      "hours": 12,
      "scope": "each_sub_period",
      "categories": [
        "technical"
      ]
    },
    {
      "id": "non_technical_max",
      "label": "Non-technical",
      "hours": 40,
      "scope": "cycle",
      "categories": [
        "non_technical"
      ],
      "kind": "max",
      "note": "Maximum, not a target. Because 40 of the 80 hours must be technical, at most 40 non-technical hours can count toward the 80."
    },
    {
      "id": "ethics",
      "label": "Ethics",
      "hours": 4,
      "scope": "cycle",
      "categories": [
        "ethics"
      ]
    },
    {
      "id": "regulatory_review",
      "label": "Board-approved Regulatory Review course",
      "hours": 2,
      "scope": "lookback_years",
      "lookbackYears": 6,
      "categories": [
        "regulatory_review"
      ],
      "note": "Required if more than six years have lapsed since the last one. Not interchangeable with ethics. Must carry a CBA approval number (RRL-/RRS-)."
    },
    {
      "id": "aa",
      "label": "Accounting & auditing",
      "hours": 24,
      "scope": "cycle",
      "categories": [
        "accounting_auditing"
      ],
      "when": "attest"
    },
    {
      "id": "gov",
      "label": "Governmental accounting & auditing",
      "hours": 24,
      "scope": "cycle",
      "categories": [
        "government"
      ],
      "when": "government_audit"
    },
    {
      "id": "prep",
      "label": "Preparation engagement subject matter",
      "hours": 8,
      "scope": "cycle",
      "categories": [
        "accounting_auditing"
      ],
      "when": "preparation_engagement",
      "unless": "attest",
      "note": "8 hours in preparation engagement subject matter. Covered by the 24 A&A hours if you also do audit/attest work."
    },
    {
      "id": "fraud",
      "label": "Fraud",
      "hours": 4,
      "scope": "cycle",
      "categories": [
        "fraud"
      ],
      "whenAny": [
        "attest",
        "government_audit",
        "preparation_engagement"
      ],
      "note": "4 hours of fraud CE if you perform A&A, government audits or preparation engagements \u2014 one requirement, not one per activity."
    }
  ],
  "newLicensee": {
    "hoursPerFullSixMonths": 20,
    "technicalShare": 0.5,
    "ethicsAndFraudAfterFullTwoYears": true,
